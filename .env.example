# 複製成 .env 後自行填入密碼（.env 已列入 .gitignore，不要提交）
MYSQL_ROOT_PASSWORD=
MYSQL_READONLY_USER=readonly
MYSQL_READONLY_PASSWORD=
# 主機連進容器 MySQL 的埠（本機若已裝 MySQL 會占用 3306）
MYSQL_HOST_PORT=3307

MAX_ROWS=200
QUERY_TIMEOUT_MS=5000

# 自架 Dify 的 network 名稱（docker network ls 查看）
DIFY_NETWORK=docker_default

# scripts/eval_dify.py 使用（Dify 應用的 API 金鑰，請自行填入）
DIFY_API_BASE=http://localhost/v1
DIFY_API_KEY=
